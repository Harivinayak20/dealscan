# Required server-only Groq provider key.
GROQ_API_KEY=
# llama-3.3-70b-versatile was deprecated by Groq on 2026-06-17.
GROQ_MODEL=openai/gpt-oss-120b
# llama-4-scout was deprecated by Groq on 2026-06-17 (https://console.groq.com/docs/deprecations).
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Public app and approved outbound destinations.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_HISTORY_REPORT_URL=
NEXT_PUBLIC_INSURANCE_URL=
NEXT_PUBLIC_LOAN_URL=
NEXT_PUBLIC_INSPECTION_URL=
NEXT_PUBLIC_PARTS_URL=
NEXT_PUBLIC_OBD_SCANNER_URL=
NEXT_PUBLIC_DETAILING_KIT_URL=
NEXT_PUBLIC_ENABLE_ADSENSE=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_ADSENSE_IN_ARTICLE_SLOT=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only admin dashboard token (required for /admin access).
ADMIN_TOKEN=

# Future server-only integrations.
MARKET_DATA_API_KEY=
VIN_HISTORY_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADSENSE_PUBLISHER_ID=

# Optional failover AI provider (free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Watchlist email alerts (optional — watch flow works without them, emails don't send).
# RESEND_API_KEY from https://resend.com; CRON_SECRET protects /api/cron/check-watches.
RESEND_API_KEY=
ALERTS_FROM_EMAIL="DealScan Alerts <alerts@dealscan.dev>"
CRON_SECRET=

# Dealscan Pro (optional — pricing page shows a waitlist state without these).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
PRO_COOKIE_SECRET=
