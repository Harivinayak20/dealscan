{
  "name": "used-car-listing-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:preview": "remotion render src/remotion/index.ts DealScanPromo out/dealscan-promo-preview.mp4 --scale=0.25",
    "remotion:render": "remotion render src/remotion/index.ts DealScanPromo out/dealscan-promo-4k.mp4",
    "ugc:scam": "remotion render src/remotion/index.ts IsThisAScam out/ugc-is-this-a-scam.mp4",
    "ugc:deal": "remotion render src/remotion/index.ts DealScoreReveal out/ugc-deal-score-reveal.mp4",
    "ugc:flags": "remotion render src/remotion/index.ts RedFlagCheck out/ugc-red-flag-check.mp4",
    "ugc:all": "npm run ugc:scam && npm run ugc:deal && npm run ugc:flags",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\" \"src/lib/__tests__/*.test.ts\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@remotion/transitions": "4.0.469",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "open-props": "^1.7.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "4.0.469",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@remotion/cli": "4.0.469",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
